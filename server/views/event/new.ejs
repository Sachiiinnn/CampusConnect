<% layout("/layouts/boilerplate.ejs") -%>

<div class="row justify-content-center">
    <div class="col-md-8">
        <h3 class="mb-4 text-center">Add New Event</h3>

        <form action="/events" method="POST" class="needs-validation" novalidate>

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" name="event[title]" class="form-control" minlength="5" maxlength="100"
                    required placeholder="e.g., AI Hackathon 2026">
                <div class="invalid-feedback">
                    Title must be between 5–100 characters.
                </div>
            </div>

            <div class="row">
                <!-- Type -->
                <div class="mb-3 col-6">
                    <label class="form-label">Type</label>
                    <select name="event[type]" class="form-select" required>
                        <option value="">Choose...</option>
                        <option value="Hackathon">Hackathon</option>
                        <option value="Internship">Internship</option>
                        <option value="Fest">Fest</option>
                        <option value="Workshop">Workshop</option>
                    </select>
                    <div class="invalid-feedback">Please select an event type.</div>
                </div>

                <!-- Mode -->
                <div class="mb-3 col-6">
                    <label class="form-label">Mode</label>
                    <select name="event[mode]" class="form-select">
                        <option value="Online">Online</option>
                        <option value="Offline">Offline</option>
                        <option value="Hybrid">Hybrid</option>
                    </select>
                </div>
            </div>

            <!-- Organizer -->
            <div class="mb-3">
                <label class="form-label">Organizer</label>
                <input type="text" name="event[organizer]" class="form-control" required placeholder="e.g., Google Developers">
                <div class="invalid-feedback">Organizer is required.</div>
            </div>

            <!-- Location -->
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input type="text" name="event[location]" class="form-control" placeholder="Delhi-NCR, Mumbai, Online">
            </div>

            <!-- Deadline -->
            <div class="mb-3">
                <label class="form-label">Application Deadline</label>
                <input type="date" name="event[deadline]" class="form-control" required>
                <div class="invalid-feedback">Deadline is required.</div>
            </div>

            <!-- Apply Link -->
            <div class="mb-3">
                <label class="form-label">Apply Link</label>
                <input type="url" name="event[applyLink]" class="form-control" required placeholder="https://example.com/apply">
                <div class="invalid-feedback">Valid application link required.</div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="event[description]" class="form-control" rows="4" required
                    placeholder="Brief description of the event"></textarea>
                <div class="invalid-feedback">Description is required.</div>
            </div>

            <!-- Tags -->
            <div class="mb-3">
                <label class="form-label">Tags</label>
                <input type="text" name="event[tags]" class="form-control" required placeholder="web, ai, ml">
                <div class="form-text">Comma separated</div>
            </div>

            <!-- Image URL -->
            <div class="mb-3">
                <label class="form-label">Image URL</label>
                <input type="url" name="event[imageURL]" class="form-control" placeholder="https://example.com/image.jpg">
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-5">
                Create Event
            </button>

        </form>
    </div>
</div>